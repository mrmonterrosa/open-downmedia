# ==========================================
# Open-DownMedia — Variables de Entorno (Dokploy / Producción)
# ==========================================

# Entorno de ejecución
NODE_ENV=production

# Puerto interno del backend
PORT=3001

# Puerto público asignado al frontend (por defecto 8080 en local, o 80 en Dokploy)
FRONTEND_PORT=8080

# Puerto público asignado al backend (opcional, por defecto 3001)
BACKEND_PORT=3001

# Clave secreta para consultar las métricas administrativas en /api/admin/metrics
ADMIN_SECRET_KEY=opendownmedia_admin_2026

# Origen permitido para CORS (usar '*' o el dominio de producción, ej. https://open-downmedia.com)
CORS_ORIGIN=*
